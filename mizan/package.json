    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "build:web": "expo export --platform web --output-dir dist",
    "test:e2e": "npm run build:web && node tests/e2e/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:ios:dev": "npx eas-cli@latest build --profile development --platform ios",
    "build:ios:preview": "npx eas-cli@latest build --profile preview --platform ios",
    "build:ios:prod": "npx eas-cli@latest build --profile production --platform ios",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production"
  },
  "private": true
}
