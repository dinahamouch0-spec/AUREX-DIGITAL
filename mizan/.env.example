# MIZAN environment — copy to .env.local (never commit real values).
# Only PUBLIC values belong in EXPO_PUBLIC_* (they are bundled into the app).

# Supabase (Pending External Setup). Leave empty to run in local-only mode.
# The anon/publishable key is safe in the client because RLS enforces ownership.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: URL of a server-side AI proxy (e.g. a Supabase Edge Function).
# The AI provider's API key lives ONLY on that server, never here.
EXPO_PUBLIC_AI_PROXY_URL=

# NEVER put SUPABASE_SERVICE_ROLE_KEY or any provider secret in this file.
