# Copy to Netlify → Site configuration → Environment variables.
# Never commit real values.

# Required: unlocks the admin dashboard on first run.
ADMIN_PASSWORD=choose-a-strong-password

# Recommended: signs the short-lived child-photo links.
SESSION_SECRET=a-long-random-string

# Optional: defaults to "admin".
ADMIN_USERNAME=admin

# Optional: new-order email notifications. Without these the site runs
# normally and simply sends no mail.
RESEND_API_KEY=
MAIL_FROM=Ya 7kayti <orders@yourdomain.com>
