# Copy this file to .env and fill in real values.
# See README.md "Deployment" for what each of these needs to be in production.

# --- Database (PostgreSQL) ---
# Local: postgresql://postgres:postgres@localhost:5432/ya7kayti
# Production: your managed Postgres connection string (Vercel Postgres, Neon, Supabase, RDS, ...)
DATABASE_URL=""

# --- Admin auth ---
# ADMIN_SESSION_SECRET must be a long random string (32+ chars) in production.
# ADMIN_SEED_EMAIL / ADMIN_SEED_PASSWORD are only used by `npm run db:seed` to
# create the first admin login — change the password after first login.
ADMIN_SESSION_SECRET=""
ADMIN_SEED_EMAIL="admin@ya7kayti.com"
ADMIN_SEED_PASSWORD=""

# --- App ---
# Public base URL used for metadata, sitemap, and absolute links.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Private object storage (S3-compatible) ---
# Child photos are stored here — this MUST be a private, non-public bucket.
# Works with AWS S3, Cloudflare R2, Backblaze B2, or (locally) `npm run dev:storage`.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="ya7kayti-uploads"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_FORCE_PATH_STYLE="true"

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Ya 7kayti <orders@ya7kayti.com>"

# --- Cron protection ---
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` on its own
# Cron Job invocations when this is set — see vercel.json.
CRON_SECRET=""
